# Copy to .env for local development. Never commit real values.
# Blank values are placeholders for me to fill in. The app must start with them blank:
# Relative paths are relative to the repo root.
# Where BioAgilytix config lives (business rules, lookup lists, prompts, templates)
# Blank: the app starts without config; features that need it ask for this setting.
CLIENT_CONFIG_DIR=clients/bioa

# Local storage (run store, review database, checkpoints)
STORAGE_DIR=./data
CHECKPOINT_DB=./data/checkpoints.sqlite
REVIEW_DB=./data/review.sqlite

# LLM provider: fake (fixtures, used by all tests) or openai (real calls)
# Blank: features that call the LLM name the missing setting when used.
LLM_PROVIDER=
OPENAI_API_KEY=
# API address, e.g. an Azure OpenAI v1 endpoint ending in /openai/v1/ (models are then deployment names). Blank: OpenAI's default.
OPENAI_BASE_URL=
EXTRACTION_MODEL=
VERIFICATION_MODEL=
DUPLICATE_JUDGE_MODEL=
# Matching, Naming and the plausibility review never fail a run: a blank model skips the step and adds a run warning.
MATCHING_MODEL=
NAMING_MODEL=
PLAUSIBILITY_MODEL=
# Retries per LLM call for timeouts and rate limits. Blank: LLM calls ask for this setting.
LLM_RETRIES=
# Local development only, read only when LLM_PROVIDER=fake: folder of fake replies (e.g. evals/cases/synthetic_001/fake_llm, for that case's documents).
FAKE_LLM_REPLIES_DIR=

# Limits. Blank means no limit.
MAX_FILE_SIZE_MB=
MAX_FILES_PER_RUN=
MAX_INPUT_TOKENS=
MAX_DUPLICATE_JUDGE_CALLS=
MAX_MATCHING_CALLS=
MAX_NAMING_CALLS=
MAX_PLAUSIBILITY_CALLS=
# Number of list values shown to Matching per item. Blank (the whole list) is recommended.
# A cut list is chosen by text similarity, so a synonym ("LN2" for "Cryo") can drop out: use this only
# as a cost control for a very large list, never to improve matching. The app warns at start when a
# Matching-allowed list has over 150 values and this setting does not cut it.
MATCHING_SHORTLIST_SIZE=

# Re-extraction attempts after extraction verification finds problems (documented default 1)
MAX_REEXTRACT=1

# Days to keep LLM request and response files. Blank keeps everything.
LLM_TRACE_RETENTION_DAYS=

# Placeholder sign-in: the configured user and roles (comma list, e.g. user,admin).
# Blank: features that need a signed-in user name the missing setting when used.
PILOT_USER=
PILOT_USER_ROLES=
