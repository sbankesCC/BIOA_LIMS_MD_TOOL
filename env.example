# Copy to .env for local development. Never commit real values.
# Blank values are placeholders for me to fill in. The app must start with them blank:
# Where BioAgilytix config lives (field rules, lookup lists, prompts, templates)
CLIENT_CONFIG_DIR=clients/bioa

# Local storage (run store, review database, checkpoints)
STORAGE_DIR=./data
CHECKPOINT_DB=./data/checkpoints.sqlite

# LLM provider: fake (fixtures, used by all tests) or openai (real calls)
LLM_PROVIDER=
OPENAI_API_KEY=
EXTRACTION_MODEL=
VERIFICATION_MODEL=
DUPLICATE_JUDGE_MODEL=