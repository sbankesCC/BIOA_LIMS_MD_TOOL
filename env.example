# Copy to .env for local development. Never commit real values.
# Blank values are placeholders for me to fill in. The app must start with them blank:
# a feature that needs a blank setting reports which setting is missing when it is used.

# Where BioAgilytix config lives (field rules, lookup lists, prompts, templates)
CLIENT_CONFIG_DIR=clients/bioa

# Local storage (run store, review database, checkpoints)
STORAGE_DIR=./data
CHECKPOINT_DB=./data/checkpoints.sqlite

# LLM provider: fake (fixtures, used by all tests) or openai (real calls)
LLM_PROVIDER=
OPENAI_API_KEY=
EXTRACTION_MODEL=
VERIFICATION_MODEL=
DUPLICATE_JUDGE_MODEL=

# Routing and retries
MAX_REEXTRACT=1
LLM_RETRIES=

# Upload limits (blank = no limit)
MAX_FILE_SIZE_MB=
MAX_FILES_PER_RUN=

# Duplicate check
MAX_DUPLICATE_JUDGE_CALLS=

# Input size limit for one LLM call, in tokens (blank = no limit)
MAX_INPUT_TOKENS=

# Retention of LLM prompts and responses in the run store, in days (blank = keep all)
LLM_TRACE_RETENTION_DAYS=

# Placeholder sign-in
PILOT_USER=
PILOT_USER_ROLES=

# Logging
LOG_LEVEL=
LOG_FORMAT=json
