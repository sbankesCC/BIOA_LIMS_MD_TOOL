# Copy to .env for local development. Never commit real values.
# Blank values are placeholders for me to fill in. The app must start with them blank:
# Relative paths are relative to the repo root.
# Where BioAgilytix config lives (field rules, lookup lists, prompts, templates)
# Blank: the app starts without config; features that need it ask for this setting.
CLIENT_CONFIG_DIR=clients/bioa

# Local storage (run store, review database, checkpoints)
STORAGE_DIR=./data
CHECKPOINT_DB=./data/checkpoints.sqlite
REVIEW_DB=./data/review.sqlite

# LLM provider: fake (fixtures, used by all tests) or openai (real calls)
# Blank: features that call the LLM name the missing setting when used.
LLM_PROVIDER=
OPENAI_API_KEY=
EXTRACTION_MODEL=
VERIFICATION_MODEL=
DUPLICATE_JUDGE_MODEL=
# Retries per LLM call for timeouts and rate limits. Blank: LLM calls ask for this setting.
LLM_RETRIES=

# Limits. Blank means no limit.
MAX_FILE_SIZE_MB=
MAX_FILES_PER_RUN=
MAX_INPUT_TOKENS=
MAX_DUPLICATE_JUDGE_CALLS=

# Re-extraction attempts after extraction verification finds problems (documented default 1)
MAX_REEXTRACT=1

# Days to keep LLM request and response files. Blank keeps everything.
LLM_TRACE_RETENTION_DAYS=

# Placeholder sign-in: the configured user and roles (comma list, e.g. user,admin).
# Blank: features that need a signed-in user name the missing setting when used.
PILOT_USER=
PILOT_USER_ROLES=
